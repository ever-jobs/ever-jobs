# ========================================
# Ever Jobs API — Environment Variables
# ========================================
# Copy this file to .env and fill in values.

# ── API Security ──────────────────────────
API_KEYS=                           # Comma-separated list of valid API keys
ENABLE_API_KEY_AUTH=false            # Enable API key authentication
API_KEY_HEADER_NAME=x-api-key       # Header name for API key

# ── Rate Limiting ─────────────────────────
RATE_LIMIT_ENABLED=false            # Enable rate limiting
RATE_LIMIT_REQUESTS=100             # Maximum requests per timeframe
RATE_LIMIT_TIMEFRAME=3600           # Timeframe for rate limiting (seconds)

# ── Proxy Configuration ──────────────────
DEFAULT_PROXIES=                    # Comma-separated list of proxies (user:pass@host:port)
# ^ Since Spec 1690: the fallback proxy list when EVER_JOBS_CRAWL_PROXIES is unset
#   (ignored under EVER_JOBS_CRAWL_PRESET=legacy, as before 1690).
CA_CERT_PATH=                       # Path to CA Certificate file for proxies

# ── Crawl Policy (Spec 1690) ────────────
# How Ever Jobs identifies itself, paces requests per host, rotates proxies and
# backs off. Every value below is the built-in default of the `polite` preset;
# leave them commented out unless you want to change one. Invalid values are
# ignored with a startup warning. Read once per process (restart after changes).
# Full guide, per-site/per-host examples and precedence: docs/CRAWL_POLICY.md
#
# Preset: polite (default) | legacy (exact pre-1690 behaviour) | strict
# EVER_JOBS_CRAWL_PRESET=polite
#
# Identity
# EVER_JOBS_CRAWL_USER_AGENT=default          # default|everjobs = honest Ever Jobs UA; browser|legacy = pre-1690 Chrome/120; or any string
# EVER_JOBS_CRAWL_USER_AGENT_MODE=identify    # identify | strict (our UA always) | plugin (plugins' declared UAs)
# EVER_JOBS_CRAWL_CONTACT=                    # e-mail/URL inserted into the default UA, e.g. crawler-ops@example.com
# EVER_JOBS_CRAWL_FROM=                       # adds a From: header, e.g. crawler-ops@example.com
# EVER_JOBS_CRAWL_STRIP_CLIENT_HINTS=true     # drop sec-ch-ua* headers when our UA is sent
#
# Proxies
# EVER_JOBS_CRAWL_PROXY_ROTATION=per-host     # per-host (one stable proxy per site) | per-scrape | per-request (pre-1690) | off
# EVER_JOBS_CRAWL_PROXIES=                    # comma list or JSON array; none|off|direct = no proxies (no DEFAULT_PROXIES fallback)
# EVER_JOBS_CRAWL_DEFAULT_PROXIES_FALLBACK=true   # use DEFAULT_PROXIES when EVER_JOBS_CRAWL_PROXIES is unset (false under legacy)
# EVER_JOBS_CRAWL_CALLER_PROXIES=any          # any | none: may a search request supply `proxies`? (none when caller overrides are not `any`)
#
# Pacing (per host, process-wide)
# EVER_JOBS_CRAWL_RATE_SCOPE=host             # host | domain (registrable domain) | site
# EVER_JOBS_CRAWL_MAX_CONCURRENT_PER_HOST=4   # requests in flight per bucket; 0 = unlimited
# EVER_JOBS_CRAWL_MIN_INTERVAL_MS=100         # minimum gap between request starts per bucket
# EVER_JOBS_CRAWL_JITTER_MS=0                 # random 0..N ms added to each gap
# EVER_JOBS_CRAWL_MAX_QUEUE_WAIT_MS=0         # fail fast after waiting this long for a slot; 0 = no limit
# EVER_JOBS_CRAWL_ADAPTIVE=true               # slow a host down after 429/503, recover on success
# EVER_JOBS_CRAWL_BUILTIN_HOSTS=true          # higher builtin limits for Greenhouse/Lever/Ashby/SmartRecruiters APIs (false under legacy)
# EVER_JOBS_CRAWL_PLUGIN_MANIFESTS=true       # apply plugins' @SourcePlugin({ crawl }) defaults (false under legacy)
# EVER_JOBS_CRAWL_BROWSER_NAVIGATION=true     # browser pages (BrowserPool.navigate): egress guard, robots.txt, pacing, 429 back-off; false = plain page.goto (false under legacy)
# EVER_JOBS_CRAWL_MAX_BUCKETS=10000           # soft LRU cap on remembered host buckets
# EVER_JOBS_CRAWL_MAX_COOLDOWN_MS=3600000     # ceiling on any host cool-down (Retry-After, Crawl-delay)
#
# Retries and back-off
# EVER_JOBS_CRAWL_RETRIES=2                   # 0-10 (a larger value is clamped to 10); a retry never follows in < 100 ms (except legacy)
# EVER_JOBS_CRAWL_RETRY_STATUSES=429,502,503,504   # none = retry no status
# EVER_JOBS_CRAWL_RETRY_BACKOFF=exponential   # exponential | linear | constant
# EVER_JOBS_CRAWL_RETRY_BASE_DELAY_MS=1000
# EVER_JOBS_CRAWL_RETRY_MAX_DELAY_MS=30000
# EVER_JOBS_CRAWL_RETRY_JITTER=true           # full jitter on the back-off
# EVER_JOBS_CRAWL_RETRY_ON_NETWORK_ERROR=false   # also retry connection resets / timeouts
# EVER_JOBS_CRAWL_RESPECT_RETRY_AFTER=true    # never retry earlier than Retry-After
# EVER_JOBS_CRAWL_MAX_RETRY_AFTER_MS=60000    # a longer Retry-After triggers the rule below
# EVER_JOBS_CRAWL_RETRY_AFTER_OVER_MAX=give-up   # give-up (cool the whole host) | cap (wait the max, then retry: pre-1690)
# EVER_JOBS_CRAWL_THROTTLE_RETRY_DELAY_MS=5000   # a 429/503 waits at least this x 2^n before retry n+1 (and cools the host that long); 0 = no floor (pre-1690)
#
# robots.txt (opt-in)
# EVER_JOBS_CRAWL_ROBOTS_TXT=off              # off | crawl-delay | respect
# EVER_JOBS_CRAWL_ROBOTS_UNREACHABLE=allow    # allow | disallow when robots.txt cannot be fetched
# EVER_JOBS_CRAWL_ROBOTS_MAX_ORIGINS=5000     # cache size (origins)
# EVER_JOBS_CRAWL_ROBOTS_TTL_MS=21600000      # 6 h
# EVER_JOBS_CRAWL_ROBOTS_ERROR_TTL_MS=300000  # 5 min for an unreachable robots.txt
# EVER_JOBS_CRAWL_ROBOTS_MAX_BYTES=524288     # bytes of robots.txt parsed
# EVER_JOBS_CRAWL_ROBOTS_MAX_RULES_PER_GROUP=2000
# EVER_JOBS_CRAWL_ROBOTS_MAX_PATTERN_CHARS=512
# EVER_JOBS_CRAWL_ROBOTS_MAX_MATCH_COST=5000000
#
# Egress guard (refuse loopback / private / link-local / cluster-internal destinations)
# EVER_JOBS_CRAWL_BLOCK_PRIVATE_NETWORKS=true # set false for local mock servers
# EVER_JOBS_CRAWL_EGRESS_ALLOW_HOSTS=         # or allow-list: localhost,127.0.0.1,*.test
#
# Discovery (plugins with several strategies, e.g. Softy)
# EVER_JOBS_CRAWL_DISCOVERY=auto              # auto | sitemap | listing
#
# Operator per-site / per-host policies and what a search request may change
# EVER_JOBS_CRAWL_POLICIES=                   # JSON, e.g. {"hosts":{"*.softy.pro":{"minIntervalMs":2000}}}
# EVER_JOBS_CRAWL_POLICY_FILE=                # path to a JSON file of the same shape (EVER_JOBS_CRAWL_POLICIES wins per field)
# EVER_JOBS_CRAWL_CALLER_OVERRIDES=any        # any | stricter (only more polite values) | none
#
# Search deadline, circuit breaker, liveness
# EVER_JOBS_CRAWL_ABORT_ON_DEADLINE=true      # cancel an abandoned source's queued and in-flight requests
# EVER_JOBS_CIRCUIT_MAX_SITES=4096            # sites the circuit breaker tracks; 0 = no cap; 250 = pre-1690
# EVER_JOBS_LIVENESS_DEADLINE_MS=60000        # bound on one liveness-enrichment batch; 0 = none
#
# Pre-1690 retry variables (still honoured; EVER_JOBS_CRAWL_* equivalents win)
# RETRY_DEFAULT_RETRIES=                      # -> EVER_JOBS_CRAWL_RETRIES, only when set
# RETRY_DEFAULT_DELAY_MS=                     # -> EVER_JOBS_CRAWL_RETRY_BASE_DELAY_MS, only when set
# RETRY_DEFAULT_BACKOFF=                      # -> EVER_JOBS_CRAWL_RETRY_BACKOFF, only when set
# RETRY_PER_SOURCE=                           # JSON {"<site>":{"retries":2,"delayMs":1000,"backoff":"linear","maxDelayMs":30000}}

# ── Softy (Spec 1691) ───────────────────
# SOFTY_MAX_LIST_PAGES=50                     # listing pages read per scrape (>= 1)
# SOFTY_MAX_DETAIL_FETCHES=100                # detail pages fetched per scrape (cache hits do not count)
# SOFTY_DETAIL_CACHE_MAX=500                  # detail cache entries; 0 disables the cache
# SOFTY_DETAIL_CACHE_TTL_MS=21600000          # detail cache TTL (6 h); 0 = no expiry
# SOFTY_LASTMOD_AS_DATE_POSTED=true           # use the sitemap lastmod as datePosted when the page has no date
# SOFTY_MAX_CONSECUTIVE_DETAIL_FAILURES=3     # stop detail fetches after N consecutive failures; 0 = never

# ── Plugin Toggle ─────────────────────────
# Comma-separated list of source plugin ids that the discovery service should
# SKIP at registration time. Whitespace tolerated; case-insensitive. Unknown ids
# log a warning but do not block boot. See docs/PLUGIN_ARCHITECTURE.md.
EVER_JOBS_DISABLED_SOURCES=         # e.g. "linkedin, indeed"

# ── Search Defaults ──────────────────────
DEFAULT_SITE_NAMES=linkedin,indeed,zip_recruiter,glassdoor,google,bayt,naukri,bdjobs,internshala,exa,upwork
DEFAULT_RESULTS_WANTED=20           # Default number of results per site
DEFAULT_DISTANCE=50                 # Default distance in miles
DEFAULT_DESCRIPTION_FORMAT=markdown # Format of job description (markdown, html, plain)
DEFAULT_COUNTRY=USA                 # Default country for Indeed/Glassdoor

# ── Caching ───────────────────────────────
ENABLE_CACHE=false                  # Enable response caching
CACHE_EXPIRY=3600                   # Cache expiry time in seconds

# ── Logging & Environment ────────────────
LOG_LEVEL=info                      # Logging level (debug, info, warn, error)
NODE_ENV=development                # Environment name (development, production)

# ── CORS ──────────────────────────────────
CORS_ORIGINS=*                      # Allowed origins for CORS (comma-separated)

# ── Server ────────────────────────────────
PORT=3001                           # Server port

# ── API Documentation ────────────────────
ENABLE_SWAGGER=true                 # Enable Swagger UI (classic) at /swg
SWAGGER_PATH=swg                    # URL path for Swagger UI
ENABLE_SCALAR=true                  # Enable Scalar API docs at /docs
SCALAR_PATH=docs                    # URL path for Scalar API Reference

# ── External API Keys ───────────────────
# EXA_API_KEY=                      # Exa AI search API key

# ── Upwork API ──────────────────────────
# Supports two OAuth2 flows:
#   client_credentials  — server-to-server (only clientId + clientSecret needed)
#   authorization_code  — user-delegated  (all four values needed)
# Grant type is auto-detected if UPWORK_GRANT_TYPE is omitted:
#   accessToken + refreshToken present → authorization_code, otherwise → client_credentials
# Per-request auth via input.auth.upwork overrides these env vars.
# UPWORK_CLIENT_ID=                 # OAuth2 client ID (required for both flows)
# UPWORK_CLIENT_SECRET=             # OAuth2 client secret (required for both flows)
# UPWORK_GRANT_TYPE=                # Optional: 'client_credentials' or 'authorization_code'
# UPWORK_ACCESS_TOKEN=              # OAuth2 access token (authorization_code flow only)
# UPWORK_REFRESH_TOKEN=             # OAuth2 refresh token (authorization_code flow only)

# ── USAJobs API ───────────────────────────
# USAJOBS_API_KEY=                  # API key from https://developer.usajobs.gov/APIRequest/Index
# USAJOBS_EMAIL=                    # Email used to register for USAJobs API access

# ── Adzuna API ────────────────────────────
# ADZUNA_APP_ID=                    # Application ID from https://developer.adzuna.com/signup
# ADZUNA_APP_KEY=                   # Application key from Adzuna developer portal

# ── Reed API ─────────────────────────────
# REED_API_KEY=                     # API key from https://www.reed.co.uk/developers

# ── Jooble API ───────────────────────────
# JOOBLE_API_KEY=                   # API key from https://jooble.org/api/about

# ── CareerJet API ────────────────────────
# CAREERJET_AFFID=                  # Affiliate ID from https://www.careerjet.com/partners/

# ── ReliefWeb API v2 ─────────────────────
# RELIEFWEB_APPNAME=                # Pre-approved appname (required since 2025-11-01); request at https://apidoc.reliefweb.int/parameters#appname
#                                   # Unset -> 'ever-jobs', which ReliefWeb answers with HTTP 403 until approved

# ── Phase 8: ATS Expansion API Keys ────
# FRESHTEAM_API_KEY=                # Freshteam API key (Bearer token)
# BULLHORN_CORP_TOKEN=              # Bullhorn corp token (from career portal JS)
# TRAKSTAR_API_KEY=                 # Trakstar Hire API key (Basic Auth, key as username)
# HIRINGTHING_API_KEY=              # HiringThing API key (Basic Auth)
# LOXO_API_TOKEN=                   # Loxo API token (optional, public board works without)
# FOUNTAIN_API_KEY=                 # Fountain API key (Bearer token)
# DEEL_API_TOKEN=                   # Deel API token (Bearer token)

# ── Greenhouse Harvest API (Spec 1735 §4.5) ────
# Harvest lists the KEY OWNER's jobs (confidential ones included) for any board,
# so the env key is used only for the board named below; every other board —
# including the company plugins that delegate to Greenhouse — reads its public
# board. A per-request auth.greenhouse.apiKey is still honoured as given.
# GREENHOUSE_API_KEY=               # Your own organisation's Harvest API key (Basic Auth, key as username)
# GREENHOUSE_HARVEST_BOARD=         # Your own board token (e.g. yourco); required for the env key to be used

# ── Phase 10: Government & ATS API Keys ────
# CAREERONESTOP_API_KEY=             # CareerOneStop Bearer token (free at careeronestop.org)
# CAREERONESTOP_USER_ID=             # CareerOneStop user ID (defaults to 'anonymous')
# ARBEITSAGENTUR_API_KEY=            # German Arbeitsagentur X-API-Key
# HOMERUN_API_KEY=                   # Homerun ATS Bearer token

# ── Phase 11: Developer API Keys ────────────
# FINDWORK_API_KEY=                  # FindWork.dev API token (free at findwork.dev)
# JOBDATAAPI_API_KEY=                # JobDataAPI key (optional, works without for testing)

# ── Phase 12: ATS & Niche Board API Keys ────
# AUTHENTICJOBS_API_KEY=             # Authentic Jobs API key (from authenticjobs.com/api/)
# TALENTLYFT_API_KEY=                # TalentLyft Bearer token (from TalentLyft admin)

# ── Phase 14: API-Key Sources ────────────────
# TALROO_PUBLISHER_ID=               # Talroo/Jobs2Careers publisher ID (free at talroo.com/publisher/)
# TALROO_PUBLISHER_PASS=             # Talroo/Jobs2Careers publisher password
# INFOJOBS_CLIENT_ID=                # InfoJobs OAuth client ID (free at developer.infojobs.net)
# INFOJOBS_CLIENT_SECRET=            # InfoJobs OAuth client secret

# ── Phase 15: European Government & Regional Boards ──
# JOBTECHDEV_API_KEY=                  # Swedish Employment Service API key (free at apirequest.jobtechdev.se)
# FRANCETRAVAIL_CLIENT_ID=             # France Travail OAuth2 client ID (free at francetravail.io)
# FRANCETRAVAIL_CLIENT_SECRET=         # France Travail OAuth2 client secret
# NAVJOBS_TOKEN=                       # Norwegian NAV bearer token (optional, auto-fetches public token)

# ── Fork-sync hardening switches (Spec 1689) ──────────────────────────
# Every behaviour the MakeDeeply fork changed or removed stays reachable
# through one of these. Unset = the default shown. Most booleans accept
# true/false, 1/0, yes/no, on/off; a few differ (e.g.
# MUNDANE_CO_CLOSE_BROWSER_POOL_AFTER_SCRAPE is on only for `true`) - the
# exact parsing of each switch is in .specify/specs/1689-fork-sync-hardening/spec.md §5.1.
#
# Shared location parser (packages/common/src/utils/location-parser.ts):
# EVER_JOBS_LOCATION_REMOTE_CITY=false        # true = legacy { city: 'Remote', country } for remote-only labels (open owner decision, see docs/questions.md)
# EVER_JOBS_LOCATION_BARE_STATE=true          # false = a bare 'Virginia' / 'VA' stays a city (the pre-fork opt-in default)
# EVER_JOBS_LOCATION_PREFER_US_STATE=true     # false = the fork's ISO-country-first reading of 'CA'/'IL'/'CO'… tails ('Downtown, Los Angeles, CA' -> Canada)
# EVER_JOBS_LOCATION_PREFER_US_STATE_AFTER_QUALIFIER=false  # true = 'Remote, CA' / 'Hybrid, DE' read as the US state, not the country
# EVER_JOBS_LOCATION_MAX_LABEL_LENGTH=256     # a ;/|-separated site chunk longer than this is kept verbatim (0 = no cap)
#
# Canonical dedup key (packages/common/src/canonical-key.ts):
# 🛑 Both default ON and both change canonicalJobId values against develop
#    574bd922 — a persistent store (store-sqlite-drizzle, store-postgres-prisma)
#    keyed on canonicalJobId sees one-time duplicates for jobs with a country
#    or a remote-only location. Set both to false to keep the old ids.
# EVER_JOBS_CANONICAL_KEY_REMOTE_BUCKET=true      # remote postings with no concrete site key to 'remote'
# EVER_JOBS_CANONICAL_KEY_NORMALIZE_COUNTRY=true  # 'US' / 'USA' / 'United States' hash to one country
#
# ATS posting country (source-ats-lever, source-ats-workday):
# EVER_JOBS_ATS_COUNTRY_OVERLAY=true          # false = the fork's behaviour: the ATS country code only in countryCode, never in location.country
#
# Outbound HTTP / browser (packages/common):
# EVER_JOBS_HTTP_PIN_REDIRECTS=true           # false = pinned company plugins follow redirects to any host again (escape hatch)
# EVER_JOBS_BROWSER_MAX_PERSISTENT_CONTEXTS=4 # idle persistent Chromium contexts closed LRU-first over this cap (0 = unbounded)
#
# MCP server (apps/mcp):
# EVER_JOBS_MCP_LOCATION_FORMAT=full          # city = the legacy city-only string
# EVER_JOBS_MCP_REQUEST_KEYS=camel            # snake = the legacy request keys; both = send both
#
# Per-plugin switches:
# PULSESPACE_STRATEGY=rendered                # auto = bundle first, browser fallback; bundle = HTTP only
# MUNDANE_CO_CLOSE_BROWSER_POOL_AFTER_SCRAPE=false  # true = the fork's close-the-shared-browser-pool after every scrape
# DOVER_JOB_URL_STYLE=apply                   # board = the pre-apply-link jobUrl /jobs/{slug}
# ADP_MAX_LIST_PAGES=100                      # 1 = first page only (the pre-pagination behaviour)
# Pre-Spec-5125 location heuristics, all default true (false = the shared parser's output only):
# AMAZON_LOCATION_HEURISTICS=true
# ARGOSPACE_LOCATION_HEURISTICS=true
# CATSONE_LOCATION_HEURISTICS=true
# CLEVERCONNECT_LOCATION_HEURISTICS=true
# EMPLOYMENTHERO_LOCATION_HEURISTICS=true
# HARRI_LOCATION_HEURISTICS=true
# JOBSOID_LOCATION_HEURISTICS=true
# PINPOINT_LOCATION_HEURISTICS=true
# THINKORBITAL_LOCATION_HEURISTICS=true
# UMANTIS_LOCATION_HEURISTICS=true
# WORKSTREAM_LOCATION_HEURISTICS=true
#
# Test / CI only (not read by the app):
# JEST_TRANSFORMER=swc                        # ts-jest = type-checked test run (npm run test:typed)
# CI repository variables: JEST_CORE_MAX_WORKERS (3), JEST_SOURCE_UNIT_MAX_WORKERS (5), RUNNER_SOURCE_UNIT (runner label for the source unit shards)

# ── New sources and board fixes (Specs 1692-1713) ─────────────────────
# No rebuild needed. Most variables are read on each call; the
# EVER_JOBS_LOCATION_* switch is read once per process. Unset = the default
# shown. Booleans accept true/false, 1/0, yes/no, on/off. Each "legacy"
# switch restores the behaviour from before its spec.
#
# Shared parsing (packages/common, packages/models):
# EVER_JOBS_SALARY_GRAMMAR=extended           # legacy = the pre-1695 salary range grammar and post-processing (Spec 1695)
# EVER_JOBS_POSTED_TIME_DETAIL=true           # false = datePosted only, no datePostedAt / datePostedPrecision / datePostedBasis (Spec 1696)
# EVER_JOBS_JOB_TYPE_SCAN_MODE=token          # label = prose-scanning plugins trust every scanned word like a whole label (Spec 1697)
# EVER_JOBS_MARKDOWN_EDGE_SAFE=true           # false = the pre-1698 Markdown output, byte for byte (Spec 1698)
# EVER_JOBS_LOCATION_ISO_COUNTRY_NAMES=true   # false = only configured countries by name, old alpha-3 spellings and old US-town / Georgia / '&' readings (Spec 1699)
#
# Multi-location search (apps/api, Spec 1700):
# EVER_JOBS_SEARCH_MAX_LOCATIONS=10           # locations searched per request, 1..25; the rest come back as bad_input diagnostics
# EVER_JOBS_SEARCH_LOCATION_INTERVAL_MS=500   # pause between one source's location calls, 0..10000 (0 = none); a plugin's own request gap is always kept
# EVER_JOBS_SEARCH_LOCATION_MEMO=             # response memo per source location loop: unset = GET and POST, get = GET only, off = none (every location fetches again)
#
# New sources:
# INHIRE_DETAIL_CONCURRENCY=1                 # InHire detail requests in flight, 1..2 (Spec 1692)
# INHIRE_MIN_INTERVAL_MS=500                  # minimum gap between InHire requests; can only be raised (max 60000)
# JOBSBYLEVEL_TRANSPORT=mcp                   # feed = RSS feed + listing-page JSON-LD instead of the MCP server (Spec 1693)
# JOBSBYLEVEL_FEED_FALLBACK=true              # false = no RSS retry when the MCP listing fails before any job
# JOBSBYLEVEL_MIN_AI_LEVEL=                   # keep listings at or above this AI level (1-4)
# JOBSBYLEVEL_MAX_AI_LEVEL=                   # keep listings at or below this AI level (1-4)
# JOBSBYLEVEL_CATEGORIES=                     # comma-separated category slugs, filtered locally (e.g. software-engineering,data)
# JOBSBYLEVEL_MAX_PAGES=10                    # listing-page cap, 1..25
# JOBSBYLEVEL_CACHE_TTL_MS=600000             # response cache lifetime (0 = no cache)
# JOBSBYLEVEL_EMIT_AI_LEVEL=true              # false = leave the extra aiLevel key off each job
# SIMPLIFYJOBS_NEWGRAD_REPO=SimplifyJobs/New-Grad-Positions        # owner/repo of the new-grad list (Spec 1694)
# SIMPLIFYJOBS_INTERNSHIPS_REPO=SimplifyJobs/Summer2027-Internships # owner/repo of the internship list (renamed each season)
# SIMPLIFYJOBS_BRANCH=dev                     # branch both lists are read from
#
# Board fixes (Specs 1701-1713):
# EVER_JOBS_LINKEDIN_LEGACY=                  # comma list of pagination,ids,pay,detail,remote or all (Spec 1701; ids = the old li-<slug>-<id> ids)
# EVER_JOBS_LINKEDIN_FETCH_COMPANY_DETAILS=false  # true = one company-page request per new company (input linkedinFetchCompanyDetails wins)
# EVER_JOBS_INDEED_ATTRIBUTE_MAPPING=true     # false = the pre-1702 remote / job-type mapping (Spec 1702)
# EVER_JOBS_INDEED_FORMATTED_LOCATION=true    # false = the pre-1702 { city, state, country } location
# EVER_JOBS_INDEED_MAX_PAGES=10               # search pages per scrape (0 / off / unlimited = no cap)
# EVER_JOBS_GLASSDOOR_LEGACY=                 # true / all, or a comma list of behaviour names (e.g. ids,job-url) (Spec 1703)
# EVER_JOBS_GLASSDOOR_MAX_PAGES=30            # page cap, up to 100
# EVER_JOBS_GOOGLE_LEGACY_PARSER=false        # true = the pre-1704 title/URL pairing parser (Spec 1704)
# EVER_JOBS_GOOGLE_MAX_PAGES=10               # page cap (clamped to 30)
# WTTJ_BOARD_MODE=off                         # on = scrape() without a company but with a search criterion runs the board search (opt-in until Q-099 is ruled on) (Spec 1705)
# WTTJ_REMOTE_MODE=                           # legacy = any remote token except an explicit "no" counts as remote
# WTTJ_DESCRIPTION_LAYOUT=                    # legacy = the old key-missions + profile description
# WTTJ_URL_LOCALE_GUARD=on                    # off = every posting language becomes the URL locale
# WTTJ_USER_AGENT_MODE=                       # browser = the pre-1705 browser User-Agent instead of our identifying one
#                                             #   (also opts the plugin into crawl userAgentMode "plugin"; EVER_JOBS_CRAWL_USER_AGENT_MODE=strict still sends the configured UA)
# WTTJ_CREDENTIAL_REFRESH=on                  # off = never fetch a credential page; a refused key is reported as blocked
# WTTJ_CREDENTIALS_SEED_URL=                  # https detail page (no query) tried before the built-in seed page
# INTERNSHALA_DEFAULT_STREAMS=both            # job | internship: streams searched when jobType is unset (Spec 1706)
# INTERNSHALA_ID_SCHEME=posting               # url-hash = the pre-1706 ids
# INTERNSHALA_MAX_PAGES=10                    # listing requests per stream, 1..50
# INTERNSHALA_SLUG_TIMESTAMP=true             # false = no detail-link epoch refinement of datePosted
# EVER_JOBS_REMOTEOK_LEGACY=                  # true / all, or a subset of search,text,urls,salary,location,ua (ua = the old browser User-Agent) (Spec 1707)
#                                             #   (ua also opts the plugin into crawl userAgentMode "plugin"; EVER_JOBS_CRAWL_USER_AGENT_MODE=strict still sends the configured UA)
# WELLFOUND_FETCH_MODE=http                   # browser = every page through the shared browser pool, as before Spec 1708
# WELLFOUND_ROUTE_MODE=landing                # feed = only the /jobs feed, filtered locally
# WELLFOUND_DESCRIPTION_SOURCE=markdown       # html = the pre-1708 reading of the description field
# WELLFOUND_JOB_URL_STYLE=id-slug             # slug = the pre-1708 /jobs/{slug} URLs
# SOLIDJOBS_DIVISIONS=                       # comma list of divisions, in scan order (unset = all eight; it = the Spec 718 scope)
# SOLIDJOBS_PAGINATE=true                     # false = one un-paged request per division, as in Spec 718 (Spec 1709)
# SOLIDJOBS_SEARCH_MODE=tokens                # phrase (alias legacy) = the Spec 718 whole-phrase matcher
# SOLIDJOBS_INPUT_FILTERS=true                # false = ignore location / isRemote / jobType / hoursOld again
# SOLIDJOBS_TIME_BUDGET_MS=90000              # time budget per scrape
# EVER_JOBS_BAYT_LEGACY_MAPPING=false         # true = the pre-1710 card mapping (Spec 1710)
# EVER_JOBS_BAYT_LEGACY_SLUG=false            # true = the pre-1710 search slug
# EVER_JOBS_BAYT_COUNTRY_SCOPE=true           # false = always search /en/international/
# EVER_JOBS_BAYT_MAX_PAGES=10                 # page cap, 1..50
# BDJOBS_MODE=api                             # html = the legacy HTML path, patched for politeness (never an automatic fallback) (Spec 1711)
# BDJOBS_STRATEGY=                            # alias read only when BDJOBS_MODE is unset; legacy-html = html
# NAUKRI_PARSER=current                       # legacy = the pre-1712 mapping (Spec 1712)
# NAUKRI_DIAGNOSTICS=current                  # legacy = the shared classifier only (a captcha 406 reads bad_input)
# ZIPRECRUITER_REGION_GUARD=true              # false = search every country, as before Spec 1713
# ZIPRECRUITER_GEO_BLOCK_TTL_MS=1800000       # geo-block memo lifetime (0 = retry every scrape)
# ZIPRECRUITER_MAX_PAGES=                     # absolute page cap (unset = min(10, the page budget the request needs))
# ZIPRECRUITER_LEGACY_PARAMS=false            # true = the pre-1713 request contract
# ZIPRECRUITER_HOURS_FILTER=true              # false = keep jobs older than hoursOld (server filters whole days only)
# ZIPRECRUITER_SESSION_EVENT=json             # json = the pre-1713 session event (default); form = the app-shaped event on a cookie jar (opt-in); off = none
# ── Workday adapter bounds (Spec 1736 §8, T11) ────────────────────────
# One Workday board's scrape (source-ats-workday, and the 55 company plugins
# that delegate to it). Detail requests are sequential and paced (~0.5-1 s
# each), so they are capped; postings past the cap or the budget are returned
# at list level (no description). Read on every scrape.
# WORKDAY_MAX_DETAIL_FETCHES=50          # detail requests per scrape; 0 = none; set >= resultsWanted to enrich everything
# WORKDAY_SCRAPE_TIME_BUDGET_MS=90000    # budget over listing + enrichment, from THIS board's scrape start (not the search's); 0 = none
#
# Keep the budget below the fan-out deadline: EVER_JOBS_FANOUT_DEADLINE_MS
# (preferred), else EVER_JOBS_SEARCH_DEADLINE_MS (fallback name), else 120000;
# 0 = no deadline. The adapter caps its budget at 3/4 of that deadline, read
# from the same variables. A board that starts late in the fan-out can still
# be abandoned by the deadline; the budget bounds how long it runs on.
# EVER_JOBS_FANOUT_DEADLINE_MS=120000
#
# The 55 Workday-backed company plugins ship ENABLED (Spec 1736 §7, T16); the
# two limits above bound their cost. Optional emergency switch only: append
# the 55 site tokens listed in docs/DEPLOYMENT.md ("Workday-backed company
# sources") to EVER_JOBS_DISABLED_SOURCES above to turn the batch off without
# a rebuild. Not needed for a normal deployment.
