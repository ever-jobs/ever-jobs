{
  "name": "@ever-jobs/root",
  "version": "0.1.0",
  "private": true,
  "description": "Ever Jobs — NestJS monorepo for multi-source job scraping",
  "license": "MIT",
  "engines": {
    "node": ">=26.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npx nx run-many --target=build --all",
    "start:dev": "npx nx run api:start:dev",
    "cli": "npx ts-node -r tsconfig-paths/register apps/cli/src/main.ts",
    "lint": "npx nx run-many --target=lint --all",
    "test": "jest",
    "test:typed": "ts-node --project tsconfig.base.json -T scripts/jest-typed.ts",
    "test:core": "jest --testPathPatterns \"(packages/(common|plugin|models|analytics)|apps/api/src|apps/api/__tests__/(jobs|integration)|apps/(mcp|cli)/__tests__)/\" --testPathIgnorePatterns e2e-spec",
    "test:e2e": "jest --testPathPatterns e2e-spec",
    "test:api": "jest --testPathPatterns apps/api/__tests__",
    "test:cli": "jest --testPathPatterns apps/cli/__tests__",
    "test:sources": "jest --testPathPatterns packages/plugins/source-",
    "test:fast": "jest --testPathPatterns apps/api/__tests__/health",
    "test:scripts": "jest --testPathPatterns scripts/__tests__ --verbose",
    "lint:docs": "ts-node --project tsconfig.base.json -r tsconfig-paths/register scripts/docs-lint.ts",
    "spec:next": "ts-node --project tsconfig.base.json -r tsconfig-paths/register scripts/next-spec-number.ts",
    "store:postgres:generate": "ts-node --project tsconfig.base.json -r tsconfig-paths/register scripts/store-postgres.ts generate",
    "store:postgres:migrate": "ts-node --project tsconfig.base.json -r tsconfig-paths/register scripts/store-postgres.ts migrate",
    "store:postgres:status": "ts-node --project tsconfig.base.json -r tsconfig-paths/register scripts/store-postgres.ts status",
    "bench:avature": "ts-node --project tsconfig.base.json -r tsconfig-paths/register packages/plugins/source-ats-avature/__tests__/avature.bench.ts",
    "bench:gem": "ts-node --project tsconfig.base.json -r tsconfig-paths/register packages/plugins/source-ats-gem/__tests__/gem.bench.ts",
    "bench:joincom": "ts-node --project tsconfig.base.json -r tsconfig-paths/register packages/plugins/source-ats-joincom/__tests__/joincom.bench.ts",
    "bench:ats-batch-1": "npm run bench:avature && npm run bench:gem && npm run bench:joincom",
    "bench:oracle": "ts-node --project tsconfig.base.json -r tsconfig-paths/register packages/plugins/source-ats-oracle/__tests__/oracle.bench.ts",
    "bench:mercor": "ts-node --project tsconfig.base.json -r tsconfig-paths/register packages/plugins/source-ats-mercor/__tests__/mercor.bench.ts",
    "bench:tesla": "ts-node --project tsconfig.base.json -r tsconfig-paths/register packages/plugins/source-tesla/__tests__/tesla.bench.ts",
    "bench:ats-batch-2": "npm run bench:oracle && npm run bench:mercor && npm run bench:tesla"
  },
  "dependencies": {
    "@apollo/server": "^5.5.1",
    "@as-integrations/express5": "^1.1.2",
    "@keyv/redis": "^5.1.6",
    "@nestjs/apollo": "^14.0.2",
    "@nestjs/cache-manager": "^12.0.0",
    "@nestjs/common": "^12.1.0",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.1.0",
    "@nestjs/graphql": "^14.0.2",
    "@nestjs/platform-express": "^12.1.0",
    "@nestjs/swagger": "^12.0.2",
    "@nestjs/throttler": "^6.7.1",
    "@prisma/client": "^6.19.3",
    "@scalar/nestjs-api-reference": "^1.2.23",
    "axios": "^1.20.0",
    "better-sqlite3": "^13.0.3",
    "cache-manager": "^7.2.9",
    "cacheable": "^2.5.0",
    "cheerio": "^1.2.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^18.0.4",
    "drizzle-orm": "^0.45.3",
    "exa-js": "^2.23.0",
    "graphql": "^16.14.2",
    "https-proxy-agent": "^9.1.0",
    "keyv": "^5.6.0",
    "nest-commander": "^3.21.0",
    "playwright": "^1.63.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "robots-parser": "^3.0.1",
    "rxjs": "^7.8.2",
    "socks-proxy-agent": "^10.1.0",
    "tldts": "^7.4.16",
    "tough-cookie": "^6.0.2",
    "turndown": "^7.2.4",
    "unpdf": "^1.8.1",
    "uuid": "^14.0.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.7",
    "@nestjs/schematics": "^12.0.5",
    "@nestjs/testing": "^12.1.0",
    "@swc/core": "^1.16.2",
    "@swc/jest": "^0.2.39",
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.3",
    "@types/supertest": "^7.2.1",
    "@types/turndown": "^5.0.6",
    "@types/uuid": "^11.0.0",
    "@typescript-eslint/eslint-plugin": "^8.70.1",
    "@typescript-eslint/parser": "^8.70.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^10.11.0",
    "fork-ts-checker-webpack-plugin": "^9.1.0",
    "jest": "^30.5.2",
    "nx": "^23.2.1",
    "prisma": "^6.19.3",
    "supertest": "^7.3.0",
    "testcontainers": "^12.1.0",
    "ts-jest": "^29.4.14",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsconfig-paths-webpack-plugin": "^4.2.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "webpack": "^5.111.1",
    "webpack-node-externals": "^3.0.0"
  },
  "overrides": {
    "lodash": "4.18.1",
    "multer": "2.4.0",
    "qs": "6.16.0",
    "webpack": "$webpack",
    "request": {
      "form-data": "2.5.6"
    },
    "external-editor": {
      "tmp": "0.2.7"
    },
    "openai": {
      "ws": "8.22.0"
    },
    "@nestjs/graphql": {
      "ws": "8.22.0"
    },
    "nx": {
      "minimatch": "10.2.6",
      "smol-toml": "1.9.0"
    },
    "@angular-devkit/core": {
      "picomatch": "4.0.7"
    },
    "testcontainers": {
      "undici": "8.11.2"
    },
    "archiver": "^8.0.0",
    "babel-plugin-istanbul": "^8.0.0",
    "glob": "^13.0.6",
    "test-exclude": "^8.0.0",
    "minimatch@^10.0.0": {
      "brace-expansion": "^5.0.12"
    },
    "express": {
      "body-parser": "1.20.8"
    },
    "@nestjs/platform-express": {
      "body-parser": "1.20.8"
    },
    "dockerode": {
      "uuid": "11.1.1"
    },
    "@apollo/server": {
      "uuid": "11.1.1"
    },
    "fast-uri": "^3.1.8",
    "@nestjs/swagger": {
      "js-yaml": "^4.3.2"
    },
    "cosmiconfig": {
      "js-yaml": "^4.3.2"
    },
    "@istanbuljs/load-nyc-config": {
      "js-yaml": "^3.15.2"
    },
    "@yarnpkg/parsers@3.0.0-rc.46": {
      "js-yaml": "^3.15.2"
    },
    "front-matter": {
      "js-yaml": "^3.15.2"
    }
  }
}
